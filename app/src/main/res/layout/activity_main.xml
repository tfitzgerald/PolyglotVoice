<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="Initializing AI..."
        android:textColor="#00FF00" />

    <ScrollView
        android:id="@+id/scrollTranscript"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/controls"
        android:layout_below="@id/tvStatus"
        android:layout_marginVertical="10dp">
        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical">

        <View
            android:id="@+id/pulseIndicator"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:alpha="0"
            android:background="@android:drawable/presence_online"
            android:backgroundTint="#00BCD4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnSave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save" android:textSize="11sp" android:layout_margin="2dp" />
            <ToggleButton android:id="@+id/toggleFlavor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textOff="Flavor OFF" android:textOn="Flavor ON" android:textSize="11sp" android:layout_margin="2dp" />
            <Button android:id="@+id/btnReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset" android:textSize="11sp" android:layout_margin="2dp" />
            <Button android:id="@+id/btnClear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear" android:textSize="11sp" android:layout_margin="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnListen"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_btn_speak_now" />
    </LinearLayout>
</RelativeLayout>