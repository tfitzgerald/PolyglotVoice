<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#121212" android:padding="16dp">

    <LinearLayout android:id="@+id/llDownload" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/tvDownloadLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Downloading AI Models..." android:textColor="#FFFFFF"/>
        <ProgressBar android:id="@+id/pbModel" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" />
    </LinearLayout>

    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_below="@id/llDownload"
        android:text="Initializing..." android:textColor="#BBBBBB" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_above="@+id/pulseContainer" android:layout_below="@id/tvStatus" android:layout_marginVertical="10dp">
        <TextView android:id="@+id/tvTranscript" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" />
    </ScrollView>

    <FrameLayout android:id="@+id/pulseContainer" android:layout_width="200dp"
        android:layout_height="200dp" android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true" android:layout_marginBottom="20dp">
        
        <View android:id="@+id/pulse1" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/circle_shape" android:visibility="invisible" />
        <View android:id="@+id/pulse2" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/circle_shape" android:visibility="invisible" />

        <ImageButton android:id="@+id/btnListen" android:layout_width="80dp" android:layout_height="80dp"
            android:layout_gravity="center" android:background="@drawable/circle_shape"
            android:backgroundTint="#444444" android:src="@android:drawable/ic_btn_speak_now" />
    </FrameLayout>
</RelativeLayout>