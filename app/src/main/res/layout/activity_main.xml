<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1F1F1F"
        app:title="PolyglotVoice"
        app:titleTextColor="#FFFFFF" />

    <Button
        android:id="@+id/btnClear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:layout_alignParentEnd="true"
        android:layout_margin="8dp"
        android:text="Clear"
        android:backgroundTint="#FF5555" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:layout_margin="8dp"
        android:text="Initializing..."
        android:textColor="#BBBBBB" />

    <ScrollView
        android:id="@+id/scrollTranscript"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnClear"
        android:layout_above="@+id/pulseContainer"
        android:layout_margin="10dp"
        android:scrollbarStyle="insideOverlay"
        android:fadeScrollbars="false"
        android:background="@drawable/transcript_bg">
        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp"
            android:textSize="18sp"
            android:textColor="#FFFFFF" />
    </ScrollView>

    <FrameLayout
        android:id="@+id/pulseContainer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <View android:id="@+id/pulse1" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/circle_shape" android:visibility="invisible" />
        <View android:id="@+id/pulse2" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/circle_shape" android:visibility="invisible" />
        <ImageButton
            android:id="@+id/btnListen"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#444444"
            android:src="@android:drawable/ic_btn_speak_now" />
    </FrameLayout>
</RelativeLayout>